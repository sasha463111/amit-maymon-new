# Supabase (production — eu-central-1 recommended)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server-side only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Preview mode (optional; disables real Supabase, uses localStorage mock)
# NEXT_PUBLIC_PREVIEW_MODE=true

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys --json`
# Public key is shipped to the browser; private key stays server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact email used as VAPID `sub`. Required by some push providers.
VAPID_SUBJECT=mailto:admin@tehila-bodyshop.example
