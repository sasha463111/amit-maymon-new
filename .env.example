# Supabase (production — eu-central-1 recommended)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role — server-side only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email-only login shared secret — server-side only, never shown to users.
# Every active Supabase account's real password is set to this same value;
# staff only enter their email, and the server fills this in behind the
# scenes. Must match what's already set on the Supabase user accounts —
# ask whoever manages prod (Vercel env vars) for the current value, don't
# invent a new one without also updating it on the Supabase side.
EMAIL_ONLY_LOGIN_PASSWORD=your-shared-login-secret

# Preview mode (optional; disables real Supabase, uses localStorage mock)
# NEXT_PUBLIC_PREVIEW_MODE=true

# Web Push (VAPID) — generate with `npx web-push generate-vapid-keys --json`
# Public key is shipped to the browser; private key stays server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact email used as VAPID `sub`. Required by some push providers.
VAPID_SUBJECT=mailto:admin@tehila-bodyshop.example
